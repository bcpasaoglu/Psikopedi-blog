# Copy to .env and fill in. Never commit the real .env.

# SQLite file by default; any SQLAlchemy URL works (install the matching driver).
DATABASE_URL=sqlite:///./psikopedi.db

# Comma-separated list, only needed if the frontend is served from another origin.
CORS_ORIGINS=

# Admin login. The admin API stays disabled (503) until all three are set.
ADMIN_USERNAME=admin
# Generate with: python -m backend.hash_password
ADMIN_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

SEED_SAMPLE_DATA=true
